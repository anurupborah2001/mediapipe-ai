# Git LFS — binary assets only.
# Text files (*.md, *.py, *.json, *.toml, *.lock, *.txt, *.cs, *.names, *.csv)
# are deliberately NOT tracked in LFS: LFS sets `diff: lfs`, which suppresses
# textual diffs, and a clone made with GIT_LFS_SKIP_SMUDGE=1 leaves them as
# pointer stubs instead of source code.

# Models
*.task   filter=lfs diff=lfs merge=lfs -text
*.tflite filter=lfs diff=lfs merge=lfs -text
*.pb     filter=lfs diff=lfs merge=lfs -text
*.h5     filter=lfs diff=lfs merge=lfs -text
*.pkl    filter=lfs diff=lfs merge=lfs -text

# Images
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.gif  filter=lfs diff=lfs merge=lfs -text

# Video / audio
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
